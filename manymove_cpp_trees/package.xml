<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>manymove_cpp_trees</name>
  <version>0.3.2</version>
  <description>Package to generate behaviortrees for manymove_planner using BehaviorTree.CPP</description>
  <maintainer email="pastoriomarco@gmail.com">Marco Pastorio</maintainer>
  <license>BSD-3-Clause</license>
  <author email="pastoriomarco@gmail.com">Marco Pastorio</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>behaviortree_cpp_v3</depend>
  <depend>rclcpp_action</depend>
  <depend>manymove_planner</depend>
  <depend>manymove_object_manager</depend>
  <depend>trajectory_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>std_srvs</depend>
  <depend>manymove_msgs</depend>
  <depend>control_msgs</depend>
  <depend>std_msgs</depend>
  <depend>simulation_interfaces</depend>
  <depend>vision_msgs</depend>
  <depend>rcpputils</depend>
  <!-- ros2_medkit deps follow the MANYMOVE_WITH_MEDKIT CMake option (default
       OFF). The rosdep condition keys off the env var of the same name:
       MANYMOVE_WITH_MEDKIT=1 -> install, unset or any other value -> skip.
       Keep this aligned with the CMake option in CMakeLists.txt. -->
  <depend condition="$MANYMOVE_WITH_MEDKIT == 1">ros2_medkit_fault_reporter</depend>
  <depend condition="$MANYMOVE_WITH_MEDKIT == 1">ros2_medkit_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_uncrustify</test_depend>
  <test_depend>ament_uncrustify</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
